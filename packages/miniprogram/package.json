{
  "name": "@tofrankie/eslint-plugin-miniprogram",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.33.0",
  "description": "eslint plugin for miniprogram",
  "author": "Frankie <1426203851@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/tofrankie/eslint-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofrankie/eslint-plugin.git",
    "directory": "packages/miniprogram"
  },
  "bugs": {
    "url": "https://github.com/tofrankie/eslint-plugin/issues"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslint-plugin-miniprogram",
    "javascript",
    "miniprogram",
    "tofrankie"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "docs"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && pnpm update:docs",
    "lint": "eslint . --cache --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "update:docs": "eslint-doc-generator",
    "publint": "publint",
    "prepublishOnly": "run-s typecheck test build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "catalog:prod"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "eslint": "catalog:peer",
    "eslint-plugin-eslint-plugin": "catalog:dev"
  }
}
